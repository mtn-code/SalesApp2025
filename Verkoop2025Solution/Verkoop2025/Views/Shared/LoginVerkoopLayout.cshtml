<!DOCTYPE html>
<html lang="en">

<head>

	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - Verkoop2025</title>
	<script type="importmap"></script>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/Verkoop2025Web.styles.css" asp-append-version="true" />
	<div class="bannerLoginVerkoop">
		<img src="~/images/logo_zwart.png" asp-append-version="true" alt="Logo prularia" />
	</div>

</head>

<body>
	<div class="centerLoginVerkoop">
		<main role="main" class="pb-3">
			@RenderBody()
		</main>
	</div>

	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
	<script>
		var cultureInfo = '@System.Globalization.CultureInfo.CurrentCulture.Name';
		if (cultureInfo != 'en-GB' && cultureInfo != 'en-US') {
			$.validator.methods.number = function (value, element) {
				return this.optional(element) ||
					/^-?(?:\d+|\d{1,3}(?:\.\d{3})+)?(?:,\d+)?$/.test(value);
			}
		}
	</script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>

</html>